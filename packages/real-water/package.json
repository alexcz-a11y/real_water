{
  "name": "real-water",
  "version": "0.1.0-alpha.1",
  "description": "A native Three.js WebGPU open-water runtime: four-band spectral ocean, bounded local interaction, gameplay queries without GPU readback, and a manifest-gated startup lease.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js",
    "dist/**/*.js.map",
    "src/**/*.ts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "three": ">=0.185.1 <0.186.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "keywords": [
    "three",
    "threejs",
    "webgpu",
    "tsl",
    "ocean",
    "water",
    "open-water",
    "waves",
    "buoyancy",
    "wake",
    "foam",
    "caustics",
    "reflection",
    "ssr",
    "traa",
    "realtime",
    "rendering",
    "game-development",
    "typescript",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexcz-a11y/real_water.git",
    "directory": "packages/real-water"
  },
  "bugs": {
    "url": "https://github.com/alexcz-a11y/real_water/issues"
  },
  "homepage": "https://github.com/alexcz-a11y/real_water/tree/main/packages/real-water#readme",
  "author": "Real Water contributors"
}
