{
  "name": "real-water",
  "version": "0.1.0-alpha.1",
  "description": "A native Three.js open-water runtime",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/*.js",
    "dist/*.js.map",
    "src/*.ts",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "three": ">=0.185.1 <0.186.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  }
}
